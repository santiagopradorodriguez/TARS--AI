# Copiá este archivo como ~/.env y completá tus valores
# cp .env.example ~/.env

# API Key de Google Gemini (requerida)
GEMINI_API_KEY=tu_api_key_aqui

# IP de Tailscale de esta PC (para links en notificaciones)
# Encontrala con: tailscale ip -4
TARS_LOCAL_IP=100.x.x.x

# Email para las notificaciones VAPID (Web Push)
TARS_VAPID_EMAIL=tu_email@ejemplo.com
